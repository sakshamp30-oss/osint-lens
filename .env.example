# ───────── Supabase (https://supabase.com → Project Settings → API) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never expose. Used for encrypted key storage, logs, moderation queue.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ───────── Encryption ─────────
# 32 random bytes, base64. Generate with:  npm run gen:key
# Losing this key makes every stored Gemini key unreadable (users must re-enter).
MASTER_ENCRYPTION_KEY=

# ───────── Upstash Redis (https://console.upstash.com → REST API) ─────────
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ───────── Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) ─────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────── App ─────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── Gemini (model only; the API key is supplied by each user) ─────────
# Primary model. `gemini-flash-latest` is Google's moving alias and tracks the
# current Flash model, so it won't get retired out from under you.
GEMINI_MODEL=gemini-flash-latest
# Comma-separated fallbacks, tried in order on 404/429/5xx. Retired model IDs
# must be removed here or they'll produce 404s mid-fallback.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.8-flash
# Optional. Only set for models that support thinking (2.5+). Omit for 2.0 models.
GEMINI_THINKING_BUDGET=
# Optional: MEDIA_RESOLUTION_LOW | MEDIA_RESOLUTION_MEDIUM | MEDIA_RESOLUTION_HIGH
GEMINI_MEDIA_RESOLUTION=

# ───────── Uploads & moderation ─────────
# Server-side hard limit (Gemini inline-request cap is ~20 MB incl. base64 overhead).
MAX_UPLOAD_MB=14
# Exposed to the browser for early validation. Keep equal to MAX_UPLOAD_MB.
NEXT_PUBLIC_MAX_UPLOAD_MB=14
# ONNX-format classifier. The `Falconsai` original is PyTorch-only; the
# `onnx-community` mirror ships the ONNX files transformers.js needs.
NSFW_MODEL=onnx-community/nsfw_image_detection-ONNX
NSFW_THRESHOLD=0.85
# false = if the classifier cannot load, reject searches (safer). true = skip moderation.
MODERATION_FAIL_OPEN=false